# 2.4.0 – sloupce a známá zařízení
msgid "Columns"
msgstr "Sloupce"

msgid "Show all columns"
msgstr "Zobrazit všechny sloupce"

msgid "All devices"
msgstr "Všechna zařízení"

msgid "Known device"
msgstr "Známé zařízení"

msgid "Known devices"
msgstr "Známá zařízení"

msgid "Unmarked devices"
msgstr "Neoznačená zařízení"

msgid "Mark as known"
